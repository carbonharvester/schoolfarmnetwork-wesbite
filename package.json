{
  "name": "school-farm-network-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir .prerender && node scripts/prerender.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/site.test.mjs"
  },
  "dependencies": {
    "gsap": "^3.13.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.2.8",
    "@fontsource-variable/geist": "^5.2.8",
    "@netlify/plugin-lighthouse": "^6.0.4",
    "@tailwindcss/vite": "^4.1.13",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
